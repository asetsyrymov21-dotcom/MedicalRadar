MEDICAL_RADAR_DB_PATH=/data/medical_radar.db

# Enable automatic collection + Telegram publishing loop inside Docker.
MEDICAL_RADAR_ENABLE_SCHEDULER=true
MEDICAL_RADAR_POLL_MINUTES=180
MEDICAL_RADAR_COLLECT_LIMIT_PER_TOPIC=5

# all: publish everything
# skip_high_hype: do not publish high hype-risk items
# high_priority: publish human trials and low hype-risk items only
MEDICAL_RADAR_MIN_PUBLISH_MODE=skip_high_hype

# Keep true until you are ready to send real Telegram posts.
TELEGRAM_DRY_RUN=true
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Translate Telegram post titles and summaries to Russian when possible.
TRANSLATE_TO_RUSSIAN=true
